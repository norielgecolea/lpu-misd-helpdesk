# Copy to .env and fill in real values:
#   cp .env.example .env

# --- PostgreSQL ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=lpu_helpdesk
POSTGRES_PORT=5434

# --- Tomcat ---
TOMCAT_PORT=8082
TOMCAT_USERNAME=admin
TOMCAT_PASSWORD=change-me

# --- Angular (dev server) ---
ANGULAR_PORT=4202

# --- Nginx ---
WEB_PORT=80
# Public helpdesk host (Cloudflare). Do not put localhost here — localhost is
# a separate nginx server that allows /kiosk. Space-separated if you need aliases.
SERVER_NAME=helpdesk.lpulaguna.com
# Cloudflare admin only — kiosk blocked here.
ADMIN_SERVER_NAME=helpdeskadmin.lpulaguna.com
# LAN campus host + IP — / → /admin, and /kiosk is allowed.
LAN_SERVER_NAME=helpdesk.lpu-laguna.edu.ph 10.1.10.12

# --- App ---
# Base64-encoded 256-bit secret for JWT signing
APP_JWT_SECRET=bHB1LW1pc2QtaGVscGRlc2stand0LXNlY3JldC1rZXktMzJieXRlcyE=

# --- Email (OTP, ticket notifications, password reset) — Office 365 SMTP ---
# Same mailbox for all outbound mail (From + SMTP auth).
MAIL_USERNAME=system.notifications@lpulaguna.edu.ph
MAIL_PASSWORD=change-me
# Links in ticket / password-reset emails (not a second mailbox)
APP_PUBLIC_BASE_URL=https://helpdesk.lpulaguna.com
APP_ADMIN_BASE_URL=https://helpdeskadmin.lpulaguna.com

# --- Microsoft Entra ID (Azure AD) app registration ---
# From Azure Portal → App registrations → your app → Overview.
# Leave blank to disable Microsoft sign-in (OTP login still works).
APP_MSAL_TENANT_ID=
APP_MSAL_CLIENT_ID=

# --- Gate attendance (read-only student / employee directory) ---
# Must match the gate system's Postgres credentials (see lpu-gate-attendance-system/.env).
GATE_ATTENDANCE_DB_HOST=127.0.0.1
GATE_ATTENDANCE_DB_PORT=5432
GATE_ATTENDANCE_DB_NAME=postgres
GATE_ATTENDANCE_DB_USER=postgres
GATE_ATTENDANCE_DB_PASSWORD=change-me
# Gate Tomcat base URL for profile photos (server-side proxy only; e.g. http://192.168.1.50:8080)
# Browsers never load this over HTTP — photos are served via /lpu-helpdesk/api/directory/photos/...
GATE_ATTENDANCE_URL=

# --- Cloudflare Tunnel ---
# From Zero Trust → Networks → Tunnels → your tunnel → token.
# Leave blank to skip the tunnel (the container will just exit/restart-loop).
CLOUDFLARE_TUNNEL_TOKEN=
