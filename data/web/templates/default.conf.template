        proxy_read_timeout 86400;
    }
}

# Cloudflare admin subdomain — kiosk blocked, land on /admin
server {
    listen       ${NGINX_PORT};
    listen  [::]:${NGINX_PORT};
    server_name  ${ADMIN_SERVER_NAME};

    absolute_redirect off;
    client_max_body_size 50m;

    location = / {
        return 302 /admin;
    }

    location ^~ /kiosk {
        return 404;
    }

